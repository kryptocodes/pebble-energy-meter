    "resources": {
      "media": [
        {
          "type": "font",
          "name": "FONT_DRUM_24",
          "file": "fonts/Arimo-Bold.ttf",
          "characterRegex": "[0-9]",
          "targetPlatforms": [
            "basalt",
            "diorite"
          ]
        },
        {
          "type": "font",
          "name": "FONT_DRUM_20",
          "file": "fonts/Arimo-Bold.ttf",
          "characterRegex": "[0-9]",
          "targetPlatforms": [
            "chalk"
          ]
        },
        {
          "type": "font",
          "name": "FONT_DRUM_34",
          "file": "fonts/Arimo-Bold.ttf",
          "characterRegex": "[0-9]",
          "targetPlatforms": [
            "emery"
          ]
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ISI",
          "file": "images/isi_28.png",
          "targetPlatforms": [
            "basalt",
            "diorite"
          ]
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ISI",
          "file": "images/isi_24.png",
          "targetPlatforms": [
            "chalk"
          ]
        },
        {
          "type": "bitmap",
          "name": "IMAGE_ISI",
          "file": "images/isi_36.png",
          "targetPlatforms": [
            "emery"
          ]
